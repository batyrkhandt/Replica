json.kind "approval"
json.pageTitle t("canvas_pairings.show.page_title")
json.productName t("application.name")
json.heading t("canvas_pairings.show.heading")
json.description t("canvas_pairings.show.description")
json.codeLabel t("canvas_pairings.show.code_label")
json.codeInstruction t("canvas_pairings.show.code_instruction")
json.code @pairing.user_code
json.repositoryLabel t("canvas_pairings.show.repository_label")
json.repository @pairing.repository.name_with_owner
json.permissions t("canvas_pairings.show.permissions")
json.learningsConsentVersion CanvasPairing::LEARNINGS_CONSENT_VERSION
json.expiration t(@pairing.refresh_token_digest ? "canvas_pairings.show.renewable_expiration" : "canvas_pairings.show.expiration")
json.connectionsLabel t("canvas_pairings.show.connections")
json.connectionsPath canvas_connections_path
json.approveLabel t("canvas_pairings.show.approve")
json.approvePath approve_canvas_pairing_path(@pairing.user_code)
json.cancelLabel t("canvas_pairings.show.cancel")
json.cancelPath repositories_path
json.authenticityToken form_authenticity_token
