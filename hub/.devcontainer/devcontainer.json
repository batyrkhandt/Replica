{
  "name": "Replica Hub",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/hub",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "none"
    }
  },
  "forwardPorts": [19500, 3036, 6006],
  "mounts": [
    "source=replica-hub-bundle,target=/usr/local/bundle,type=volume",
    "source=replica-hub-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "onCreateCommand": "sudo chown -R vscode:vscode /usr/local/bundle node_modules",
  "portsAttributes": {
    "19500": { "label": "Replica Hub" },
    "3036": { "label": "Vite HMR" },
    "6006": { "label": "Storybook" }
  },
  "postCreateCommand": "bin/setup --skip-server",
  "runArgs": [
    "--publish",
    "127.0.0.1:19500:19500",
    "--publish",
    "127.0.0.1:3036:3036",
    "--publish",
    "127.0.0.1:6006:6006"
  ],
  "remoteUser": "vscode"
}
